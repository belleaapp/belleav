rules_version = '2';
// Storage BelleaV : lecture publique (photos + catalogue publié), écriture admin uniquement.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    // Catalogue public lu par la boutique (aucune lecture Firestore côté client)
    match /catalog/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }
    // Photos produits, catégories, bannières
    match /{folder}/{file} {
      allow read: if folder in ['products', 'categories', 'site'];
      allow write: if isAdmin() && folder in ['products', 'categories', 'site']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
